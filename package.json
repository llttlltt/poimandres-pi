{
	"name": "poimandres-pi",
	"version": "0.1.0",
	"description": "pi coding agent theme based on the poimandres VSCode theme",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-theme",
		"poimandres",
		"theme"
	],
	"files": [
		"themes/pi",
		"README.md"
	],
	"pi": {
		"themes": [
			"./themes/pi"
		]
	},
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"clean:themes": "rm -rf themes && mkdir -p themes",
		"prebuild": "pnpm check && pnpm test && pnpm clean:themes",
		"build": "node --import tsx src/generate-pi-theme.ts",
		"check": "tsc --noEmit",
		"test": "vitest run test/pi-theme-schema.test.ts",
		"test:generated": "vitest run test/generated-theme.test.ts"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"ajv": "^8.20.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"vitest": "^3.2.6"
	}
}
