{
	"name": "poimandres-theme-extractor",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"clean:themes": "rm -rf themes && mkdir -p themes",
		"prebuild": "pnpm check && pnpm test && pnpm clean:themes",
		"build": "node --import tsx src/generate-pi-theme.ts",
		"check": "tsc --noEmit",
		"test": "vitest run test/pi-theme-schema.test.ts",
		"test:generated": "vitest run test/generated-theme.test.ts"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"ajv": "^8.20.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"vitest": "^3.2.6"
	}
}
